{{!
    @template local_iconrestyle/designer

    The icon designer. The structure is rendered once; the script fills the grid, the inspector and the preview.

    Context variables required for this template:
    * contextid - context being edited
    * contextname - its name
    * fgfield - the foreground colour control: name, label and tokens
    * bgfield - the background colour control

    Example context (json):
    {
        "contextid": 1,
        "contextname": "System",
        "fgfield": {"name": "fg", "label": "Foreground", "tokens": [{"value": "token:primary", "label": "Primary"}]},
        "bgfield": {"name": "bg", "label": "Background", "tokens": [{"value": "token:primary", "label": "Primary"}]}
    }
}}
<div class="irs" data-region="designer" data-contextid="{{contextid}}">
    <p class="irs-scope">
        {{#str}}editing, local_iconrestyle{{/str}}
        <span class="irs-pill" data-region="scope-name">{{contextname}}</span>
    </p>

    <div class="irs-toolbar" role="search">
        <div class="irs-search">
            <label class="sr-only visually-hidden" for="irs-search">{{#str}}searchicons, local_iconrestyle{{/str}}</label>
            <input type="search" class="form-control" id="irs-search" data-region="search" autocomplete="off"
                placeholder="{{#str}}searchicons, local_iconrestyle{{/str}}">
        </div>
        <label class="sr-only visually-hidden" for="irs-kind">{{#str}}filterkind, local_iconrestyle{{/str}}</label>
        <select class="custom-select form-select" id="irs-kind" data-region="kind">
            <option value="all">{{#str}}kindall, local_iconrestyle{{/str}}</option>
            <option value="font">{{#str}}kindfont, local_iconrestyle{{/str}}</option>
            <option value="image">{{#str}}kindimage, local_iconrestyle{{/str}}</option>
        </select>
        <label class="sr-only visually-hidden" for="irs-state">{{#str}}filterstate, local_iconrestyle{{/str}}</label>
        <select class="custom-select form-select" id="irs-state" data-region="state">
            <option value="all">{{#str}}stateall, local_iconrestyle{{/str}}</option>
            <option value="modified">{{#str}}statemodified, local_iconrestyle{{/str}}</option>
            <option value="shared">{{#str}}stateshared, local_iconrestyle{{/str}}</option>
        </select>
        <span class="irs-count" data-region="count" role="status" aria-live="polite"></span>
    </div>

    <div class="irs-layout">
        <section class="irs-browser" aria-label="{{#str}}iconlist, local_iconrestyle{{/str}}">
            <div class="irs-grid" data-region="grid" tabindex="0">
                <div class="irs-grid-spacer" data-region="grid-spacer">
                    <div class="irs-grid-window" data-region="grid-window"></div>
                </div>
            </div>
            <p class="irs-empty" data-region="empty" hidden>{{#str}}noicons, local_iconrestyle{{/str}}</p>
            <p class="irs-loading" data-region="loading">{{#str}}loading, local_iconrestyle{{/str}}</p>
        </section>

        <section class="irs-side" aria-label="{{#str}}editor, local_iconrestyle{{/str}}">
            <p class="irs-placeholder" data-region="placeholder">{{#str}}selecticonhint, local_iconrestyle{{/str}}</p>

            <div class="irs-preview" data-region="preview" hidden>
                <div class="irs-preview-head">
                    <h3 class="irs-subtitle">{{#str}}previewtitle, local_iconrestyle{{/str}}</h3>
                    <div class="btn-group irs-surface" role="group" aria-label="{{#str}}surface, local_iconrestyle{{/str}}">
                        <button type="button" class="btn btn-secondary active" data-action="surface" data-surface="light"
                            aria-pressed="true">{{#str}}surfacelight, local_iconrestyle{{/str}}</button>
                        <button type="button" class="btn btn-secondary" data-action="surface" data-surface="dark"
                            aria-pressed="false">{{#str}}surfacedark, local_iconrestyle{{/str}}</button>
                    </div>
                </div>
                <div class="irs-preview-cols" data-region="preview-surface">
                    <div class="irs-preview-col" data-area="default">
                        <span class="irs-preview-label">{{#str}}previewdefault, local_iconrestyle{{/str}}</span>
                        <div class="irs-preview-cells" data-region="cells-default"></div>
                    </div>
                    <div class="irs-preview-col irs-preview-current" data-area="current">
                        <span class="irs-preview-label">{{#str}}previewcurrent, local_iconrestyle{{/str}}</span>
                        <div class="irs-preview-cells" data-region="cells-current"></div>
                    </div>
                    <div class="irs-preview-col irs-preview-new" data-area="new">
                        <span class="irs-preview-label">{{#str}}previewnew, local_iconrestyle{{/str}}</span>
                        <div class="irs-preview-cells" data-region="cells-new"></div>
                    </div>
                </div>
                <p class="irs-contrast" data-region="contrast" role="status" hidden></p>
            </div>

            <div class="irs-inspector" data-region="inspector" hidden>
                <h2 class="irs-title" data-region="title"></h2>
                <p class="irs-origin">
                    <span class="irs-pill" data-region="origin"></span>
                </p>
                <p class="irs-notice" data-region="shared-notice" hidden></p>

                <div class="irs-field" data-region="artwork">
                    <span class="irs-label">{{#str}}artwork, local_iconrestyle{{/str}}</span>
                    <div class="irs-artwork-row">
                        <label class="btn btn-secondary irs-upload" for="irs-upload">
                            {{#str}}uploadartwork, local_iconrestyle{{/str}}
                        </label>
                        <input type="file" id="irs-upload" class="irs-upload-input" data-region="upload"
                            accept=".svg,.png,.webp,image/svg+xml,image/png,image/webp">
                        <button type="button" class="btn btn-secondary" data-action="remove-artwork" hidden>
                            {{#str}}removeartwork, local_iconrestyle{{/str}}
                        </button>
                        <span class="irs-artwork-name" data-region="artwork-name" role="status"></span>
                    </div>
                    <p class="irs-hint" data-region="artwork-hint" hidden></p>
                </div>

                {{#fgfield}}{{> local_iconrestyle/colour_field}}{{/fgfield}}
                {{#bgfield}}{{> local_iconrestyle/colour_field}}{{/bgfield}}

                <div class="irs-field irs-row">
                    <label class="irs-label" for="irs-shape">{{#str}}shape, local_iconrestyle{{/str}}</label>
                    <select class="custom-select form-select" id="irs-shape" data-region="shape">
                        <option value="">{{#str}}shapenone, local_iconrestyle{{/str}}</option>
                        <option value="square">{{#str}}shapesquare, local_iconrestyle{{/str}}</option>
                        <option value="rounded">{{#str}}shaperounded, local_iconrestyle{{/str}}</option>
                        <option value="circle">{{#str}}shapecircle, local_iconrestyle{{/str}}</option>
                    </select>
                </div>
                <div class="irs-field irs-row">
                    <label class="irs-label" for="irs-padding">{{#str}}padding, local_iconrestyle{{/str}}</label>
                    <input type="range" id="irs-padding" data-region="padding" min="0" max="100" step="5" value="0">
                    <output data-region="padding-value"></output>
                </div>
                <div class="irs-field irs-row">
                    <label class="irs-label" for="irs-opacity">{{#str}}opacity, local_iconrestyle{{/str}}</label>
                    <input type="range" id="irs-opacity" data-region="opacity" min="10" max="100" step="5" value="100">
                    <output data-region="opacity-value"></output>
                </div>

                <button type="button" class="btn btn-secondary" data-action="reset-rule">
                    {{#str}}resetinherited, local_iconrestyle{{/str}}
                </button>
            </div>
        </section>
    </div>

    <div class="irs-staging" data-region="staging" role="region" aria-label="{{#str}}stagingbar, local_iconrestyle{{/str}}">
        <span class="irs-staged" data-region="staged" role="status" aria-live="polite"></span>
        <div class="irs-staging-actions">
            <button type="button" class="btn btn-secondary" data-action="undo" disabled>
                {{#str}}undo, local_iconrestyle{{/str}}
            </button>
            <button type="button" class="btn btn-secondary" data-action="redo" disabled>
                {{#str}}redo, local_iconrestyle{{/str}}
            </button>
            <button type="button" class="btn btn-secondary" data-action="discard" disabled>
                {{#str}}discard, local_iconrestyle{{/str}}
            </button>
            <button type="button" class="btn btn-primary" data-action="save" disabled>
                {{#str}}save, local_iconrestyle{{/str}}
            </button>
        </div>
    </div>
</div>
