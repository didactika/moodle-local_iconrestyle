{{!
    @template local_iconrestyle/variant_chips

    The variants of the selected icon, one chip for each place where it applies.

    Context variables required for this template:
    * variants - the variants, each with key, label, active and changed

    Example context (json):
    {
        "variants": [
            {"key": "core:a/setting#1||", "label": "Everywhere", "active": true, "changed": false},
            {"key": "core:a/setting#7|admin|", "label": "Faculty of Arts · Administration pages", "active": false,
                "changed": true}
        ]
    }
}}
{{#variants}}
<button type="button" class="irs-chip{{#active}} irs-active{{/active}}" data-action="pick-variant" data-key="{{key}}"
    aria-pressed="{{#active}}true{{/active}}{{^active}}false{{/active}}">
    {{label}}
    {{#changed}}<span class="irs-dot" role="img" aria-label="{{#str}}modified, local_iconrestyle{{/str}}"></span>{{/changed}}
</button>
{{/variants}}
