{{!
    @template local_iconrestyle/filters/components

    The components of the catalogue, each with a box to choose it and how many icons it has.

    Context variables required for this template:
    * rows - name, count and checked
    * more - text that says the list was cut, empty when it was not
    * none - whether no component matches

    Example context (json):
    {
        "rows": [{"name": "core", "count": 540, "checked": false}, {"name": "mod_forum", "count": 4, "checked": true}],
        "more": "",
        "none": false
    }
}}
{{#rows}}
<label class="irs-filter-row"><input type="checkbox" data-filter="components" value="{{name}}"{{#checked}} checked{{/checked}}>
    <span class="irs-filter-name">{{name}}</span><span class="irs-filter-count">{{count}}</span></label>
{{/rows}}
{{#more}}<p class="irs-theme-note">{{more}}</p>{{/more}}
{{#none}}<p class="irs-theme-note">{{#str}}importnoresults, local_iconrestyle{{/str}}</p>{{/none}}
