{{!
    @template local_iconrestyle/filters/purposes

    The purposes of the activities, as chips.

    Context variables required for this template:
    * rows - value, label, count and checked

    Example context (json):
    {
        "rows": [{"value": "assessment", "label": "Assessment", "count": 3, "checked": false}]
    }
}}
{{#rows}}
<label class="irs-chipcheck"><input type="checkbox" data-filter="purposes" value="{{value}}"{{#checked}} checked{{/checked}}><span>{{label}} <small>{{count}}</small></span></label>
{{/rows}}
