{{!
    @template local_iconrestyle/icon_cards

    The visible window of the icon grid. Rendered in one pass each time the window moves.

    Context variables required for this template:
    * cards - icons to show, each with key, label, component, font, classes, imageurl, modified, shared and selected

    Example context (json):
    {
        "cards": [
            {"key": "core:a/setting", "label": "a/setting", "component": "core", "font": true,
                "classes": "icon fa fa-gear fa-fw", "modified": true, "shared": false, "selected": false},
            {"key": "core:i/agg_mean", "label": "i/agg_mean", "component": "core", "font": false,
                "imageurl": "https://example.org/theme/image.php/boost/core/1/i/agg_mean", "modified": false,
                "shared": false, "selected": true}
        ]
    }
}}
{{#cards}}
<button type="button" class="irs-card{{#selected}} irs-selected{{/selected}}" data-action="select" data-key="{{key}}"
    aria-pressed="{{#selected}}true{{/selected}}{{^selected}}false{{/selected}}" title="{{key}}">
    <span class="irs-card-icon">
        {{#font}}<i class="{{classes}}" aria-hidden="true"></i>{{/font}}
        {{^font}}<img class="icon" src="{{imageurl}}" alt="">{{/font}}
    </span>
    <span class="irs-card-name">{{label}}</span>
    <span class="irs-card-component">{{component}}</span>
    {{#modified}}<span class="irs-dot" role="img" aria-label="{{#str}}modified, local_iconrestyle{{/str}}"></span>{{/modified}}
    {{#shared}}<span class="irs-shared" aria-hidden="true">&#8801;</span>{{/shared}}
</button>
{{/cards}}
