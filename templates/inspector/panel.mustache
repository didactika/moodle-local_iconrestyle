{{!
    @template local_iconrestyle/inspector/panel

    The editing panel of the open icon: its title, the preview, the tabs and the button that removes the variant.

    Example context (json):
    {}
}}
<aside class="irs-panel" data-region="panel" aria-label="{{#str}}editor, local_iconrestyle{{/str}}" hidden>
    <header class="irs-panel-head">
        <div class="irs-panel-title">
            <h2 class="irs-title" data-region="title"></h2>
            <span class="irs-pill" data-region="origin"></span>
        </div>
        <div class="irs-panel-actions">
            <button type="button" class="irs-iconbtn" data-action="copy-look" aria-pressed="false"
                aria-label="{{#str}}copylook, local_iconrestyle{{/str}}" title="{{#str}}copylook, local_iconrestyle{{/str}}">
                {{> local_iconrestyle/common/icon_copy}}
            </button>
            <button type="button" class="btn btn-secondary irs-close" data-action="close-panel"
                aria-label="{{#str}}closepanel, local_iconrestyle{{/str}}" title="{{#str}}closepanel, local_iconrestyle{{/str}}">
                &#10005;
            </button>
        </div>
    </header>

    {{> local_iconrestyle/preview/panel}}

    <div class="irs-tabs" role="tablist" aria-label="{{#str}}editor, local_iconrestyle{{/str}}">
        <button type="button" class="irs-tab irs-active" role="tab" id="irs-tab-style" data-action="tab"
            data-tab="style" aria-selected="true" aria-controls="irs-panel-style">
            {{#str}}tabstyle, local_iconrestyle{{/str}}
        </button>
        <button type="button" class="irs-tab" role="tab" id="irs-tab-places" data-action="tab"
            data-tab="places" aria-selected="false" aria-controls="irs-panel-places" tabindex="-1">
            {{#str}}tabplaces, local_iconrestyle{{/str}}
            <span class="irs-badge" data-region="places-count"></span>
        </button>
    </div>

    <div class="irs-panel-body">
        <div class="irs-notice" data-region="shared-notice" role="status" hidden>
            <span data-region="shared-notice-text"></span>
            <button type="button" class="irs-x" data-action="dismiss-notice"
                aria-label="{{#str}}dismiss, local_iconrestyle{{/str}}" title="{{#str}}dismiss, local_iconrestyle{{/str}}">
                {{> local_iconrestyle/common/icon_close}}
            </button>
        </div>
        {{> local_iconrestyle/inspector/style_tab}}
        {{> local_iconrestyle/places/tab}}
    </div>

    <footer class="irs-panel-foot">
        <button type="button" class="irs-pillbtn irs-pillbtn-danger" data-action="remove-variant">
            {{> local_iconrestyle/common/icon_trash}} {{#str}}removevariant, local_iconrestyle{{/str}}
        </button>
    </footer>
</aside>
