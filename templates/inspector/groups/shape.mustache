{{!
    @template local_iconrestyle/inspector/groups/shape

    The shape group of the style tab.

    Example context (json):
    {}
}}
<details class="irs-group">
    <summary>{{#str}}groupshape, local_iconrestyle{{/str}}</summary>
    <div class="irs-field">
        <span class="irs-label" id="irs-shape-label">{{#str}}shape, local_iconrestyle{{/str}}</span>
        <div class="irs-shapes" role="group" aria-labelledby="irs-shape-label" data-prop="shape">
            <button type="button" class="irs-shape" data-value="" aria-pressed="false">
                <span class="irs-shape-sample"></span>{{#str}}shapedefault, local_iconrestyle{{/str}}
            </button>
            <button type="button" class="irs-shape" data-value="square" aria-pressed="false">
                <span class="irs-shape-sample irs-square"></span>{{#str}}shapesquare, local_iconrestyle{{/str}}
            </button>
            <button type="button" class="irs-shape" data-value="rounded" aria-pressed="false">
                <span class="irs-shape-sample irs-rounded"></span>{{#str}}shaperounded, local_iconrestyle{{/str}}
            </button>
            <button type="button" class="irs-shape" data-value="circle" aria-pressed="false">
                <span class="irs-shape-sample irs-circle"></span>{{#str}}shapecircle, local_iconrestyle{{/str}}
            </button>
            <button type="button" class="irs-shape" data-value="pill" aria-pressed="false">
                <span class="irs-shape-sample irs-pill-shape"></span>{{#str}}shapepill, local_iconrestyle{{/str}}
            </button>
        </div>
    </div>
    {{#radius}}{{> local_iconrestyle/inspector/slider_field}}{{/radius}}
    {{#borderwidth}}{{> local_iconrestyle/inspector/slider_field}}{{/borderwidth}}
    <div class="irs-field irs-row">
        <label class="irs-label" for="irs-bs">{{#str}}borderstyle, local_iconrestyle{{/str}}</label>
        <select class="custom-select form-select" id="irs-bs" data-prop="bs">
            <option value="">{{#str}}propdefault, local_iconrestyle{{/str}}</option>
            <option value="solid">{{#str}}bordersolid, local_iconrestyle{{/str}}</option>
            <option value="dashed">{{#str}}borderdashed, local_iconrestyle{{/str}}</option>
            <option value="dotted">{{#str}}borderdotted, local_iconrestyle{{/str}}</option>
            <option value="double">{{#str}}borderdouble, local_iconrestyle{{/str}}</option>
        </select>
    </div>
    {{#bcfield}}{{> local_iconrestyle/colour/field}}{{/bcfield}}
    {{#outlinewidth}}{{> local_iconrestyle/inspector/slider_field}}{{/outlinewidth}}
    {{#outlineoffset}}{{> local_iconrestyle/inspector/slider_field}}{{/outlineoffset}}
    {{#ocfield}}{{> local_iconrestyle/colour/field}}{{/ocfield}}
</details>
