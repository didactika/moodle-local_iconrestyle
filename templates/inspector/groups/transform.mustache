{{!
    @template local_iconrestyle/inspector/groups/transform

    The transform group of the style tab.

    Example context (json):
    {}
}}
<details class="irs-group">
    <summary>{{#str}}grouptransform, local_iconrestyle{{/str}}</summary>
    {{#rotate}}{{> local_iconrestyle/inspector/slider_field}}{{/rotate}}
    {{#skewx}}{{> local_iconrestyle/inspector/slider_field}}{{/skewx}}
    {{#skewy}}{{> local_iconrestyle/inspector/slider_field}}{{/skewy}}
    <div class="irs-field irs-flips">
        <button type="button" class="irs-toggle" data-flip="flipx" aria-pressed="false">{{#str}}flipx, local_iconrestyle{{/str}}</button>
        <button type="button" class="irs-toggle" data-flip="flipy" aria-pressed="false">{{#str}}flipy, local_iconrestyle{{/str}}</button>
    </div>
</details>
