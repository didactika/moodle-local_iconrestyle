{{!
    @template local_iconrestyle/inspector/groups/effects

    The effects group of the style tab.

    Example context (json):
    {}
}}
<details class="irs-group">
    <summary>{{#str}}groupeffects, local_iconrestyle{{/str}}</summary>
    {{#opacity}}{{> local_iconrestyle/inspector/slider_field}}{{/opacity}}
    <div class="irs-field irs-row">
        <label class="irs-label" for="irs-shadow">{{#str}}shadow, local_iconrestyle{{/str}}</label>
        <select class="custom-select form-select" id="irs-shadow" data-prop="shadow">
            <option value="">{{#str}}propdefault, local_iconrestyle{{/str}}</option>
            <option value="none">{{#str}}shadownone, local_iconrestyle{{/str}}</option>
            <option value="soft">{{#str}}shadowsoft, local_iconrestyle{{/str}}</option>
            <option value="medium">{{#str}}shadowmedium, local_iconrestyle{{/str}}</option>
            <option value="strong">{{#str}}shadowstrong, local_iconrestyle{{/str}}</option>
            <option value="glow">{{#str}}shadowglow, local_iconrestyle{{/str}}</option>
            <option value="inner">{{#str}}shadowinner, local_iconrestyle{{/str}}</option>
            <option value="lifted">{{#str}}shadowlifted, local_iconrestyle{{/str}}</option>
            <option value="hard">{{#str}}shadowhard, local_iconrestyle{{/str}}</option>
        </select>
    </div>
    <div class="irs-field irs-row">
        <label class="irs-label" for="irs-ds">{{#str}}dropshadow, local_iconrestyle{{/str}}</label>
        <select class="custom-select form-select" id="irs-ds" data-prop="ds">
            <option value="">{{#str}}propdefault, local_iconrestyle{{/str}}</option>
            <option value="none">{{#str}}shadownone, local_iconrestyle{{/str}}</option>
            <option value="soft">{{#str}}shadowsoft, local_iconrestyle{{/str}}</option>
            <option value="medium">{{#str}}shadowmedium, local_iconrestyle{{/str}}</option>
            <option value="strong">{{#str}}shadowstrong, local_iconrestyle{{/str}}</option>
            <option value="glow">{{#str}}shadowglow, local_iconrestyle{{/str}}</option>
        </select>
    </div>
    {{#scfield}}{{> local_iconrestyle/colour/field}}{{/scfield}}
    <div class="irs-field irs-row">
        <label class="irs-label" for="irs-blend">{{#str}}blend, local_iconrestyle{{/str}}</label>
        <select class="custom-select form-select" id="irs-blend" data-prop="blend">
            <option value="">{{#str}}propdefault, local_iconrestyle{{/str}}</option>
            <option value="normal">{{#str}}blendnormal, local_iconrestyle{{/str}}</option>
            <option value="multiply">{{#str}}blendmultiply, local_iconrestyle{{/str}}</option>
            <option value="screen">{{#str}}blendscreen, local_iconrestyle{{/str}}</option>
            <option value="overlay">{{#str}}blendoverlay, local_iconrestyle{{/str}}</option>
            <option value="darken">{{#str}}blenddarken, local_iconrestyle{{/str}}</option>
            <option value="lighten">{{#str}}blendlighten, local_iconrestyle{{/str}}</option>
            <option value="difference">{{#str}}blenddifference, local_iconrestyle{{/str}}</option>
        </select>
    </div>
    <div class="irs-field irs-row">
        <label class="irs-label" for="irs-hover">{{#str}}hover, local_iconrestyle{{/str}}</label>
        <select class="custom-select form-select" id="irs-hover" data-prop="hover">
            <option value="">{{#str}}propdefault, local_iconrestyle{{/str}}</option>
            <option value="none">{{#str}}shadownone, local_iconrestyle{{/str}}</option>
            <option value="grow">{{#str}}hovergrow, local_iconrestyle{{/str}}</option>
            <option value="shrink">{{#str}}hovershrink, local_iconrestyle{{/str}}</option>
            <option value="lift">{{#str}}hoverlift, local_iconrestyle{{/str}}</option>
            <option value="tilt">{{#str}}hovertilt, local_iconrestyle{{/str}}</option>
            <option value="fade">{{#str}}hoverfade, local_iconrestyle{{/str}}</option>
        </select>
    </div>
</details>
