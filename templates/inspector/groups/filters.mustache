{{!
    @template local_iconrestyle/inspector/groups/filters

    The filters group of the style tab.

    Example context (json):
    {}
}}
<details class="irs-group">
    <summary>{{#str}}groupfilters, local_iconrestyle{{/str}}</summary>
    {{#brightness}}{{> local_iconrestyle/inspector/slider_field}}{{/brightness}}
    {{#contrast}}{{> local_iconrestyle/inspector/slider_field}}{{/contrast}}
    {{#saturate}}{{> local_iconrestyle/inspector/slider_field}}{{/saturate}}
    {{#grayscale}}{{> local_iconrestyle/inspector/slider_field}}{{/grayscale}}
    {{#hue}}{{> local_iconrestyle/inspector/slider_field}}{{/hue}}
    {{#sepia}}{{> local_iconrestyle/inspector/slider_field}}{{/sepia}}
    {{#invert}}{{> local_iconrestyle/inspector/slider_field}}{{/invert}}
    {{#blur}}{{> local_iconrestyle/inspector/slider_field}}{{/blur}}
</details>
