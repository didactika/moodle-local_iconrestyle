    <summary>{{#str}}groupspacing, local_iconrestyle{{/str}}</summary>
    {{#padding}}{{> local_iconrestyle/inspector/sides_field}}{{/padding}}
    {{#margin}}{{> local_iconrestyle/inspector/sides_field}}{{/margin}}
    {{#scale}}{{> local_iconrestyle/inspector/slider_field}}{{/scale}}
</details>
