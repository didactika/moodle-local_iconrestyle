{{!
    @template local_iconrestyle/inspector/groups/artwork

    The artwork group of the style tab.

    Example context (json):
    {}
}}
<details class="irs-group" data-region="group-artwork" open>
    <summary>{{#str}}artwork, local_iconrestyle{{/str}}</summary>
    <div class="irs-field" data-region="artwork">
        <div class="irs-artwork-row">
            <label class="btn btn-outline-secondary btn-sm irs-upload" for="irs-upload">
                {{> local_iconrestyle/common/icon_plus}} {{#str}}uploadartwork, local_iconrestyle{{/str}}
            </label>
            <input type="file" id="irs-upload" class="irs-upload-input" data-region="upload"
                accept=".svg,.png,.webp,image/svg+xml,image/png,image/webp">
            <span class="irs-file-chip" data-region="artwork-chip">
                <span class="irs-artwork-name" data-region="artwork-name" role="status"></span>
                <button type="button" class="irs-x" data-action="remove-artwork" hidden
                    aria-label="{{#str}}removeartwork, local_iconrestyle{{/str}}" title="{{#str}}removeartwork, local_iconrestyle{{/str}}">
                    {{> local_iconrestyle/common/icon_close}}
                </button>
            </span>
        </div>
        <p class="irs-hint" data-region="artwork-hint" hidden></p>
    </div>
</details>
