{{!
    @template local_iconrestyle/inspector/slider_field

    A slider for one design property, with its value and a button that puts it back to Moodle's own.

    Context variables required for this template:
    * prop - name of the design property
    * label - visible label
    * min - lowest value
    * max - highest value
    * step - step
    * default - value the slider rests at while the property is not set

    Example context (json):
    {
        "prop": "radius",
        "label": "Corner radius",
        "min": 0,
        "max": 100,
        "step": 1,
        "default": 0
    }
}}
<div class="irs-field irs-slider">
    <div class="irs-slider-head">
        <label class="irs-label" for="irs-{{prop}}">{{label}}</label>
        <input type="number" class="form-control irs-num" data-prop-num="{{prop}}" min="{{min}}" max="{{max}}" step="{{step}}"
            aria-label="{{label}}" placeholder="{{#str}}propdefault, local_iconrestyle{{/str}}">
        <button type="button" class="btn btn-link btn-sm irs-reset" data-action="reset-prop" data-prop="{{prop}}"
            aria-label="{{#str}}resetproperty, local_iconrestyle, {{label}}{{/str}}" title="{{#str}}resetproperty, local_iconrestyle, {{label}}{{/str}}">
            &#10005;
        </button>
    </div>
    <input type="range" id="irs-{{prop}}" data-prop="{{prop}}" min="{{min}}" max="{{max}}" step="{{step}}"
        value="{{default}}" data-default="{{default}}">
</div>
