{{!
    @template local_iconrestyle/inspector/style_tab

    The style tab of the editing panel, made of groups of properties.

    Example context (json):
    {}
}}
<div class="irs-tabpanel" role="tabpanel" id="irs-panel-style" aria-labelledby="irs-tab-style" data-region="tab-style">
    {{> local_iconrestyle/inspector/groups/looks}}

    {{> local_iconrestyle/inspector/groups/colour}}

    {{> local_iconrestyle/inspector/groups/artwork}}

    {{> local_iconrestyle/inspector/groups/shape}}

    {{> local_iconrestyle/inspector/groups/spacing}}

    {{> local_iconrestyle/inspector/groups/transform}}

    {{> local_iconrestyle/inspector/groups/effects}}

    {{> local_iconrestyle/inspector/groups/filters}}
</div>
