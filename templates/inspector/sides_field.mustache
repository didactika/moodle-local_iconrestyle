{{!
    @template local_iconrestyle/inspector/sides_field

    One property with a value for each side, such as padding or margin, with a button that links the four sides.

    Context variables required for this template:
    * group - padding or margin
    * label, reset, link - texts
    * sides - the four sides: prop, label, min and max

    Example context (json):
    {
        "group": "padding",
        "label": "Padding",
        "reset": "Reset padding",
        "link": "Link the four sides",
        "sides": [{"prop": "pt", "label": "Top", "min": 0, "max": 3}]
    }
}}
<div class="irs-field" data-sides="{{group}}">
    <div class="irs-slider-head">
        <span class="irs-label" id="irs-{{group}}-label">{{label}}</span>
        <button type="button" class="btn btn-link btn-sm irs-reset" data-action="reset-sides" data-group="{{group}}"
            aria-label="{{reset}}" title="{{reset}}">
            &#10005;
        </button>
    </div>
    <div class="irs-sides" role="group" aria-labelledby="irs-{{group}}-label">
        {{#sides}}
            <label class="irs-side"><span>{{label}}</span>
                <input type="number" class="form-control" data-prop="{{prop}}" min="{{min}}" max="{{max}}" step="0.05"></label>
        {{/sides}}
        <button type="button" class="irs-link" data-action="toggle-link" data-group="{{group}}" aria-pressed="true"
            aria-label="{{link}}" title="{{link}}">
            {{> local_iconrestyle/common/icon_linked}}
            {{> local_iconrestyle/common/icon_unlinked}}
        </button>
    </div>
</div>
