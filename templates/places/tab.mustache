{{!
    @template local_iconrestyle/places/tab

    The tab that lists the places where the open icon has a variant and adds more.

    Example context (json):
    {}
}}
<div class="irs-tabpanel" role="tabpanel" id="irs-panel-places" aria-labelledby="irs-tab-places"
    data-region="tab-places" hidden>
    <p class="irs-help">{{#str}}placeshelp, local_iconrestyle{{/str}}</p>
    <div class="irs-variants" data-region="variants" role="group" aria-label="{{#str}}appliesto, local_iconrestyle{{/str}}"></div>
    <div class="irs-places-actions">
        <button type="button" class="irs-pillbtn irs-pillbtn-primary" data-action="add-places">
            {{> local_iconrestyle/common/icon_plus}} {{#str}}addplaces, local_iconrestyle{{/str}}
        </button>
        <button type="button" class="irs-pillbtn" data-action="copy-mode" hidden>
            {{> local_iconrestyle/common/icon_copy}} <span data-region="copy-mode-label"></span>
        </button>
    </div>
</div>
