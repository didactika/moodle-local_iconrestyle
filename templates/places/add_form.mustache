{{!
    @template local_iconrestyle/places/add_form

    The body of the modal that adds places where an icon has its own look.

    Context variables required for this template:
    * pages - kinds of page a rule can be limited to: value and label
    * regions - regions of a page a rule can be limited to: value and label
    * hasmodes - whether this site has colour modes
    * modes - the colour modes: value, label and whether it is the one the page is shown in

    Example context (json):
    {
        "pages": [{"value": "admin", "label": "Administration pages"}],
        "regions": [{"value": "navbar", "label": "Navigation bar"}],
        "hasmodes": true,
        "modes": [{"value": "light", "label": "Light mode", "checked": true}, {"value": "dark", "label": "Dark mode", "checked": false}]
    }
}}
<div class="irs-places-form" data-region="places-form">
    <fieldset class="irs-field">
        <legend class="irs-label">{{#str}}wherelocation, local_iconrestyle{{/str}}</legend>
        <div class="irs-seg" role="radiogroup">
            <label class="irs-seg-option">
                <input type="radio" name="irs-kind" value="site" checked>
                <span>{{#str}}wheresite, local_iconrestyle{{/str}}</span>
            </label>
            <label class="irs-seg-option">
                <input type="radio" name="irs-kind" value="category">
                <span>{{#str}}wherecategories, local_iconrestyle{{/str}}</span>
            </label>
            <label class="irs-seg-option">
                <input type="radio" name="irs-kind" value="course">
                <span>{{#str}}wherecourses, local_iconrestyle{{/str}}</span>
            </label>
            <label class="irs-seg-option">
                <input type="radio" name="irs-kind" value="activity">
                <span>{{#str}}whereactivities, local_iconrestyle{{/str}}</span>
            </label>
        </div>
    </fieldset>

    <div class="irs-field" data-kind-field="category" data-fieldtype="autocomplete" hidden>
        <label class="irs-label" for="irs-places-category">{{#str}}wherecategories, local_iconrestyle{{/str}}</label>
        <select multiple id="irs-places-category" data-kind="category" class="form-control"></select>
        <p class="irs-hint">{{#str}}wherecategoryhint, local_iconrestyle{{/str}}</p>
    </div>
    <div class="irs-field" data-kind-field="course" data-fieldtype="autocomplete" hidden>
        <label class="irs-label" for="irs-places-course">{{#str}}wherecourses, local_iconrestyle{{/str}}</label>
        <select multiple id="irs-places-course" data-kind="course" class="form-control"></select>
    </div>
    <div class="irs-field" data-kind-field="activity" data-fieldtype="autocomplete" hidden>
        <label class="irs-label" for="irs-places-activity">{{#str}}whereactivities, local_iconrestyle{{/str}}</label>
        <select multiple id="irs-places-activity" data-kind="activity" class="form-control"></select>
        <p class="irs-hint">{{#str}}whereactivityhint, local_iconrestyle{{/str}}</p>
    </div>

    <fieldset class="irs-checks">
        <legend class="irs-label">{{#str}}wherepages, local_iconrestyle{{/str}}</legend>
        {{#pages}}
        <label class="irs-check"><input type="checkbox" data-region="where-page" value="{{value}}"> {{label}}</label>
        {{/pages}}
    </fieldset>
    <fieldset class="irs-checks">
        <legend class="irs-label">{{#str}}whereregions, local_iconrestyle{{/str}}</legend>
        {{#regions}}
        <label class="irs-check"><input type="checkbox" data-region="where-region" value="{{value}}"> {{label}}</label>
        {{/regions}}
    </fieldset>

    {{#hasmodes}}
    <fieldset class="irs-field">
        <legend class="irs-label">{{#str}}wheremode, local_iconrestyle{{/str}}</legend>
        <div class="irs-seg" role="radiogroup">
            {{#modes}}
            <label class="irs-seg-option">
                <input type="radio" name="irs-mode" value="{{value}}"{{#checked}} checked{{/checked}}>
                <span>{{label}}</span>
            </label>
            {{/modes}}
        </div>
    </fieldset>
    {{/hasmodes}}

    <label class="irs-check irs-copy">
        <input type="checkbox" data-region="places-copy" checked> {{#str}}placescopy, local_iconrestyle{{/str}}
    </label>
    <p class="irs-hint irs-error" data-region="places-error" role="alert" hidden></p>
</div>
