{{!
    @template local_iconrestyle/location_results

    The categories, courses or activities found by the search of the variant form.

    Context variables required for this template:
    * places - the places found, each with contextid, name and detail

    Example context (json):
    {
        "places": [
            {"contextid": 42, "name": "Introduction to design", "detail": "DES101"},
            {"contextid": 43, "name": "Faculty of Arts", "detail": ""}
        ]
    }
}}
{{#places}}
<li>
    <button type="button" class="irs-result" data-contextid="{{contextid}}" data-name="{{name}}">
        {{name}}{{#detail}} <span class="irs-result-detail">{{detail}}</span>{{/detail}}
    </button>
</li>
{{/places}}
