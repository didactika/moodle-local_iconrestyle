{{!
    @template local_iconrestyle/preview/panel

    The preview of the open icon: the original and the edited look, on a light or a dark surface.

    Example context (json):
    {}
}}
<div class="irs-preview" data-region="preview">
    <div class="irs-preview-head">
        <div class="irs-seg-group" role="group" aria-label="{{#str}}previewview, local_iconrestyle{{/str}}">
            <button type="button" class="irs-seg-btn irs-active" data-action="preview-view" data-view="edited"
                aria-pressed="true">{{#str}}previewedited, local_iconrestyle{{/str}}</button>
            <button type="button" class="irs-seg-btn" data-action="preview-view" data-view="original"
                aria-pressed="false">{{#str}}previeworiginal, local_iconrestyle{{/str}}</button>
            <button type="button" class="irs-seg-btn" data-action="preview-view" data-view="compare"
                aria-pressed="false">{{#str}}previewcompare, local_iconrestyle{{/str}}</button>
        </div>
        <div class="irs-seg-group irs-surface" data-region="surface-group" role="group" aria-label="{{#str}}surface, local_iconrestyle{{/str}}">
            <button type="button" class="irs-seg-btn irs-active" data-action="surface" data-surface="light"
                aria-pressed="true">{{#str}}surfacelight, local_iconrestyle{{/str}}</button>
            <button type="button" class="irs-seg-btn" data-action="surface" data-surface="dark"
                aria-pressed="false">{{#str}}surfacedark, local_iconrestyle{{/str}}</button>
        </div>
    </div>
    <p class="irs-mode-note" data-region="mode-note" role="status" hidden></p>
    <div class="irs-preview-cols" data-region="preview-surface" data-view="edited">
        <div class="irs-preview-col" data-area="default">
            <span class="irs-preview-label">{{#str}}previeworiginal, local_iconrestyle{{/str}}</span>
            <div class="irs-preview-cells" data-region="cells-default"></div>
        </div>
        <div class="irs-preview-col" data-area="new">
            <span class="irs-preview-label">{{#str}}previewedited, local_iconrestyle{{/str}}</span>
            <div class="irs-preview-cells" data-region="cells-new"></div>
        </div>
    </div>
    <p class="irs-contrast" data-region="contrast" role="status" hidden></p>
</div>
