{{!
    @template local_iconrestyle/toolbar/bar

    The bar above the grid: back, search, filters, count, save status, undo, redo and the actions menu.

    Context variables required for this template:
    * adminurl - where Back goes when there is no previous page

    Example context (json):
    {
        "adminurl": "https://example.org/admin/search.php"
    }
}}
<header class="irs-bar" role="search">
    <button type="button" class="irs-back" data-action="history-back" data-fallback="{{adminurl}}"
        title="{{#str}}back, local_iconrestyle{{/str}}">
        {{> local_iconrestyle/common/icon_back}}<span>{{#str}}back, local_iconrestyle{{/str}}</span>
    </button>
    <div class="irs-search">
        {{> local_iconrestyle/common/icon_search}}
        <label class="sr-only visually-hidden" for="irs-search">{{#str}}searchicons, local_iconrestyle{{/str}}</label>
        <input type="search" class="form-control" id="irs-search" data-region="search" autocomplete="off"
            placeholder="{{#str}}searchicons, local_iconrestyle{{/str}}">
    </div>
    {{> local_iconrestyle/filters/panel}}
    <button type="button" class="irs-pillbtn irs-selectbtn" data-action="selection-start" aria-pressed="false"
        title="{{#str}}selectstarthelp, local_iconrestyle{{/str}}">
        {{> local_iconrestyle/common/icon_select}}<span>{{#str}}selectstart, local_iconrestyle{{/str}}</span>
    </button>
    <span class="irs-count" data-region="count" role="status" aria-live="polite"></span>
    <span class="irs-status" data-region="status" data-state="saved" role="status" aria-live="polite">
        <span class="irs-status-icon irs-status-saved">{{> local_iconrestyle/common/icon_check}}</span>
        <span class="irs-status-icon irs-status-busy">{{> local_iconrestyle/common/icon_refresh}}</span>
        <span class="irs-status-icon irs-status-error">{{> local_iconrestyle/common/icon_alert}}</span>
        <span class="irs-status-text" data-region="status-text">{{#str}}statussaved, local_iconrestyle{{/str}}</span>
    </span>
    <div class="irs-tools">
        <button type="button" class="irs-iconbtn" data-action="undo" disabled
            title="{{#str}}undo, local_iconrestyle{{/str}} (Ctrl+Z)" aria-label="{{#str}}undo, local_iconrestyle{{/str}}">
            {{> local_iconrestyle/common/icon_undo}}
        </button>
        <button type="button" class="irs-iconbtn" data-action="redo" disabled
            title="{{#str}}redo, local_iconrestyle{{/str}} (Ctrl+Y)" aria-label="{{#str}}redo, local_iconrestyle{{/str}}">
            {{> local_iconrestyle/common/icon_redo}}
        </button>
        <div class="irs-menu">
            <button type="button" class="irs-iconbtn" data-action="menu-toggle" aria-haspopup="true"
                aria-expanded="false" title="{{#str}}actionsmenu, local_iconrestyle{{/str}}"
                aria-label="{{#str}}actionsmenu, local_iconrestyle{{/str}}">
                {{> local_iconrestyle/common/icon_more}}
            </button>
            <div class="irs-menu-list" data-region="menu" role="menu" hidden>
                <button type="button" role="menuitem" data-action="undo" disabled>
                    {{> local_iconrestyle/common/icon_undo}}<span>{{#str}}undo, local_iconrestyle{{/str}}</span><kbd>Ctrl Z</kbd>
                </button>
                <button type="button" role="menuitem" data-action="redo" disabled>
                    {{> local_iconrestyle/common/icon_redo}}<span>{{#str}}redo, local_iconrestyle{{/str}}</span><kbd>Ctrl Y</kbd>
                </button>
                <hr>
                <button type="button" role="menuitem" data-action="exchange-export">
                    {{> local_iconrestyle/common/icon_download}}<span>{{#str}}exportcustomisations, local_iconrestyle{{/str}}</span>
                </button>
                <button type="button" role="menuitem" data-action="exchange-import">
                    {{> local_iconrestyle/common/icon_upload}}<span>{{#str}}importcustomisations, local_iconrestyle{{/str}}</span>
                </button>
            </div>
        </div>
    </div>
    <input type="file" class="irs-upload-input" data-region="exchange-file" tabindex="-1" aria-hidden="true"
        accept=".iconrestyle,.json,.txt,text/plain,application/json">
</header>
