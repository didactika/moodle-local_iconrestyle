{{!
    @template local_iconrestyle/designer/page

    The icon designer. The structure is rendered once; the script fills the grid, the panel and the preview.

    Context variables required for this template:
    * config - settings and text for the script, as JSON
    * adminurl - where Back goes when there is no previous page
    * fgfield, bgfield, bcfield, scfield - the colour controls: name and label
    * padding, margin - the properties with a value for each side
    * radius, borderwidth, scale, rotate, opacity, brightness, contrast, saturate, grayscale, hue, blur - sliders: prop, label, min,
      max, step and default

    Example context (json):
    {
        "config": "{}",
        "adminurl": "https://example.org/admin/search.php",
        "fgfield": {"name": "fg", "label": "Foreground"},
        "bgfield": {"name": "bg", "label": "Background"},
        "bcfield": {"name": "bc", "label": "Border colour"},
        "scfield": {"name": "sc", "label": "Shadow colour"},
        "padding": {"group": "padding", "label": "Padding", "reset": "Reset", "link": "Link", "sides": []},
        "margin": {"group": "margin", "label": "Margin", "reset": "Reset", "link": "Link", "sides": []},
        "radius": {"prop": "radius", "label": "Corner radius", "min": 0, "max": 100, "step": 1, "default": 0}
    }
}}
<div class="irs" data-region="designer" data-config="{{config}}">
    <div class="irs-layout" data-region="layout">
        <section class="irs-browser" aria-label="{{#str}}iconlist, local_iconrestyle{{/str}}">
            {{> local_iconrestyle/toolbar/bar}}
            <div class="irs-grid" data-region="grid" tabindex="0">
                <div class="irs-grid-spacer" data-region="grid-spacer">
                    <div class="irs-grid-window" data-region="grid-window"></div>
                </div>
            </div>
            {{> local_iconrestyle/selection/bar}}
            <p class="irs-empty" data-region="empty" hidden>{{#str}}noicons, local_iconrestyle{{/str}}</p>
            <p class="irs-loading" data-region="loading">{{#str}}loading, local_iconrestyle{{/str}}</p>
        </section>

        {{> local_iconrestyle/inspector/panel}}
    </div>
</div>
