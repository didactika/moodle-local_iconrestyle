{{!
    @template local_iconrestyle/exchange/import_rows

    The icons of a package, each with a box to choose it, what would happen to it and how many rules it has.

    Context variables required for this template:
    * rows - the icons: slot, rules, isnew, updates, skipped, disabled and checked
    * more - text that says the list was cut, empty when it was not
    * none - whether no icon matches

    Example context (json):
    {
        "rows": [
            {"slot": "core:a/setting", "rules": 4, "isnew": false, "updates": true, "skipped": false, "disabled": false, "checked": true},
            {"slot": "core:t/delete", "rules": 1, "isnew": true, "updates": false, "skipped": false, "disabled": false, "checked": true}
        ],
        "more": "",
        "none": false
    }
}}
{{#rows}}
<label class="irs-review-row{{#disabled}} irs-disabled{{/disabled}}"><input type="checkbox" data-region="import-row" value="{{slot}}"{{#checked}} checked{{/checked}}{{#disabled}} disabled{{/disabled}}>
    <span class="irs-review-name">{{slot}}</span>
    <span class="irs-review-rules">{{#str}}importrules, local_iconrestyle, {{rules}}{{/str}}</span>
    {{#isnew}}<span class="irs-state irs-state-new">{{#str}}importrownew, local_iconrestyle{{/str}}</span>{{/isnew}}
    {{#updates}}<span class="irs-state irs-state-updates">{{#str}}importrowupdates, local_iconrestyle{{/str}}</span>{{/updates}}
    {{#skipped}}<span class="irs-state irs-state-skipped">{{#str}}importrowskipped, local_iconrestyle{{/str}}</span>{{/skipped}}
</label>
{{/rows}}
{{#more}}<p class="irs-theme-note">{{more}}</p>{{/more}}
{{#none}}<p class="irs-theme-note">{{#str}}importnoresults, local_iconrestyle{{/str}}</p>{{/none}}
