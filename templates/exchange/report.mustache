{{!
    @template local_iconrestyle/exchange/report

    What importing a package would do.

    Context variables required for this template:
    * created, updated, deleted, skipped, assets - counts
    * issues - the reasons rules would be left out, the first ones

    Example context (json):
    {
        "created": 12,
        "updated": 3,
        "deleted": 0,
        "skipped": 1,
        "assets": 2,
        "issues": ["core:a/setting: this site has no place named course:shortname=XYZ."]
    }
}}
<ul class="irs-import-counts">
    <li>{{#str}}importcreated, local_iconrestyle, {{created}}{{/str}}</li>
    <li>{{#str}}importupdated, local_iconrestyle, {{updated}}{{/str}}</li>
    {{#deleted}}<li>{{#str}}importdeleted, local_iconrestyle, {{deleted}}{{/str}}</li>{{/deleted}}
    <li>{{#str}}importassets, local_iconrestyle, {{assets}}{{/str}}</li>
</ul>
{{#skipped}}
    <p class="irs-import-skipped">{{#str}}importskipped, local_iconrestyle, {{skipped}}{{/str}}</p>
    <ul class="irs-import-issues">
        {{#issues}}<li>{{.}}</li>{{/issues}}
    </ul>
{{/skipped}}
