{{!
    @template local_iconrestyle/colour/field

    One colour control: a picker, a hex box with a cross that clears it, and a searchable list of the colours of the theme.

    Context variables required for this template:
    * name - fg or bg
    * label - visible label

    Example context (json):
    {}
}}
<div class="irs-field irs-colour" data-colour="{{name}}">
    <label class="irs-label" for="irs-{{name}}-hex">{{label}}</label>
    <div class="irs-colour-row">
        <input type="color" class="irs-colour-picker" data-region="{{name}}-picker" value="#000000"
            aria-label="{{label}}" title="{{label}}">
        <div class="irs-with-x">
            <input type="text" class="form-control irs-colour-hex" id="irs-{{name}}-hex" data-region="{{name}}-hex"
                maxlength="9" spellcheck="false" autocomplete="off" placeholder="#rrggbb">
            <button type="button" class="irs-x" data-action="clear-{{name}}"
                aria-label="{{#str}}clearcolour, local_iconrestyle{{/str}}" title="{{#str}}clearcolour, local_iconrestyle{{/str}}">
                {{> local_iconrestyle/common/icon_close}}
            </button>
        </div>
        <div class="irs-theme">
            <span class="irs-swatch" data-region="{{name}}-themeswatch" aria-hidden="true" hidden></span>
            <input type="text" class="form-control irs-theme-input" role="combobox" aria-expanded="false"
                aria-autocomplete="list" aria-controls="irs-{{name}}-themelist" data-region="{{name}}-themeinput"
                autocomplete="off" spellcheck="false" placeholder="{{#str}}choosethemecolour, local_iconrestyle{{/str}}"
                aria-label="{{#str}}searchthemecolours, local_iconrestyle{{/str}}">
            <span class="irs-caret" aria-hidden="true">{{> local_iconrestyle/common/icon_chevron}}</span>
            <div class="irs-theme-panel" data-region="{{name}}-themepanel" hidden>
                <div class="irs-theme-list" id="irs-{{name}}-themelist" role="listbox" data-region="{{name}}-themelist"></div>
            </div>
        </div>
    </div>
    <p class="irs-hint" data-region="{{name}}-hint" hidden></p>
</div>
