{{!
    @template local_iconrestyle/grid/icon_cards

    The visible window of the icon grid. Rendered in one pass each time the window moves.

    Context variables required for this template:
    * cards - icons to show, each with key, label, component, font, image, container, modtype, classes, imageurl, modified,
      shared, selected and, while icons are being chosen, picking, picked, pressed and unpickable

    Example context (json):
    {
        "cards": [
            {"key": "core:a/setting", "label": "a/setting", "component": "core", "font": true, "image": false,
                "classes": "icon fa fa-gear fa-fw", "modified": true, "shared": false, "selected": false},
            {"key": "purpose:assessment", "label": "assessment", "component": "purpose", "container": true,
                "classes": "activityiconcontainer assessment", "imageurl": "https://example.org/monologo",
                "modified": false, "shared": false, "selected": false},
            {"key": "core:i/agg_mean", "label": "i/agg_mean", "component": "core", "font": false, "image": true,
                "imageurl": "https://example.org/theme/image.php/boost/core/1/i/agg_mean", "modified": false,
                "shared": false, "selected": true}
        ]
    }
}}
{{#cards}}
<button type="button" class="irs-card{{#selected}} irs-selected{{/selected}}{{#picking}} irs-picking{{/picking}}{{#picked}} irs-picked{{/picked}}" data-action="select" data-key="{{key}}"
    aria-pressed="{{#pressed}}true{{/pressed}}{{^pressed}}false{{/pressed}}" title="{{key}}"{{#unpickable}} disabled{{/unpickable}}>
    <span class="irs-card-icon"><span class="irs-card-fit">
        {{#font}}<i class="{{classes}}" aria-hidden="true"></i>{{/font}}
        {{#image}}<img class="icon" src="{{imageurl}}" alt="">{{/image}}
        {{#container}}
        <span class="{{modtype}}"><span class="{{classes}} irs-box"><img class="activityicon" src="{{imageurl}}" alt=""></span></span>
        {{/container}}
    </span></span>
    <span class="irs-card-name">{{label}}</span>
    <span class="irs-card-component">{{component}}</span>
    {{#picking}}<span class="irs-pick" aria-hidden="true">{{> local_iconrestyle/common/icon_check}}</span>{{/picking}}
    {{#modified}}<span class="irs-dot" role="img" aria-label="{{#str}}modified, local_iconrestyle{{/str}}"></span>{{/modified}}
    {{#shared}}<span class="irs-shared" aria-hidden="true">&#8801;</span>{{/shared}}
</button>
{{/cards}}
